DB_URL=jdbc:mysql://localhost:3306/badminton_ecommerce?connectionTimeZone=UTC
DB_USERNAME=badminton_app
DB_PASSWORD=CHANGE_ME
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
# Seven days. Keep this in sync with the persistent browser session policy.
JWT_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev

# Payments: enable only after entering the shop's real receiving account/merchant keys.
PAYMENT_SANDBOX=true
PAYMENT_WEB_URL=http://localhost:5173
PAYMENT_PUBLIC_API_URL=
PAYMENT_BANK_ENABLED=false
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_ACCOUNT_NAME=
# SePay: use HMAC-SHA256 authentication on the webhook and keep this value private.
SEPAY_WEBHOOK_ENABLED=false
SEPAY_WEBHOOK_SECRET=
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_ENABLED=false
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
